[Unit]
Description=CTFd Cyber Range FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
User=cce
Group=cce
WorkingDirectory=/home/cce/cyber-range/ctf-api
EnvironmentFile=-/home/cce/cyber-range/ctf-api/.env
ExecStart=/home/cce/cyber-range/ctf-api/venv/bin/uvicorn api:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
